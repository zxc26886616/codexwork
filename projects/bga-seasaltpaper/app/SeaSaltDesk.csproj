<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SeaSaltDesk</AssemblyName>
    <Version>1.3.1</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <EmbeddedResource Include="table.js" LogicalName="SeaSaltDesk.table.js" />
    <EmbeddedResource Include="login.js" LogicalName="SeaSaltDesk.login.js" />
    <EmbeddedResource Include="lobby.js" LogicalName="SeaSaltDesk.lobby.js" />
  </ItemGroup>
</Project>
